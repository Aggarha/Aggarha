generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  RESELLER
  MODERATOR
  ADMIN
}

enum VerificationLevel {
  UNVERIFIED
  PHONE_VERIFIED
  EMAIL_VERIFIED
  ID_VERIFIED
}

enum ListingMode {
  RENT
  SWAP
  BOTH
}

enum ListingStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
  FLAGGED
}

enum DealStatus {
  PENDING
  CONFIRMED
  COMPLETED
  DISPUTED
  CANCELED
}

model User {
  id                 String            @id @default(cuid())
  email              String?           @unique
  phone              String?           @unique
  passwordHash       String?
  role               UserRole          @default(USER)
  verificationLevel  VerificationLevel @default(UNVERIFIED)
  emailVerifiedAt    DateTime?
  phoneVerifiedAt    DateTime?
  idVerifiedAt       DateTime?
  trustScore         Decimal           @db.Decimal(5, 2) @default(50)
  trustTier          Int               @default(0)
  xp                 Int               @default(0)
  level              Int               @default(1)
  isBanned           Boolean           @default(false)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  profile            Profile?
  ownedListings      Listing[]         @relation("ListingOwner")
  initiatedDeals     Deal[]            @relation("DealInitiator")
  dealsAsOwner       Deal[]            @relation("DealOwner")
  dealsAsRenter      Deal[]            @relation("DealRenter")
  writtenReviews     Review[]          @relation("ReviewAuthor")
  receivedReviews    Review[]          @relation("ReviewTarget")
  accounts           Account[]
  sessions           Session[]

  @@index([role])
  @@index([trustScore])
  @@index([level])
}

model Profile {
  id               String   @id @default(cuid())
  userId           String   @unique
  handle           String   @unique
  displayName      String
  bio              String?
  avatarUrl        String?
  city             String?
  country          String?
  responseRate     Decimal  @db.Decimal(5, 2) @default(0)
  completionRate   Decimal  @db.Decimal(5, 2) @default(0)
  successfulDeals  Int      @default(0)
  failedDeals      Int      @default(0)
  reviewCount      Int      @default(0)
  averageRating    Decimal  @db.Decimal(3, 2) @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id               String     @id @default(cuid())
  slug             String     @unique
  name             String
  description      String?
  parentId         String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  parent           Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children         Category[] @relation("CategoryTree")
  listings         Listing[]

  @@index([parentId])
}

model Location {
  id               String    @id @default(cuid())
  city             String
  state            String?
  country          String
  latitude         Decimal?  @db.Decimal(10, 7)
  longitude        Decimal?  @db.Decimal(10, 7)
  postalCode       String?
  formattedAddress String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  listings         Listing[]

  @@index([city, country])
}

model Listing {
  id                String        @id @default(cuid())
  ownerId           String
  categoryId        String
  locationId        String?
  title             String
  description       String
  mode              ListingMode
  status            ListingStatus @default(DRAFT)
  quantity          Int           @default(1)
  priceAmount       Decimal?      @db.Decimal(12, 2)
  currencyCode      String?       @db.VarChar(3)
  trustScoreSnapshot Decimal?     @db.Decimal(5, 2)
  ownerLevelSnapshot Int?
  featuredUntil     DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  owner             User          @relation("ListingOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  category          Category      @relation(fields: [categoryId], references: [id])
  location          Location?     @relation(fields: [locationId], references: [id])
  deals             Deal[]

  @@index([ownerId])
  @@index([categoryId])
  @@index([locationId])
  @@index([status, mode])
}

model Deal {
  id                String     @id @default(cuid())
  listingId         String
  initiatorId       String
  ownerId           String
  renterId          String
  status            DealStatus  @default(PENDING)
  initiatedAt       DateTime    @default(now())
  ownerConfirmedAt  DateTime?
  renterConfirmedAt DateTime?
  completedAt       DateTime?
  disputedAt        DateTime?
  canceledAt        DateTime?
  xpReleased        Boolean     @default(false)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  listing           Listing     @relation(fields: [listingId], references: [id], onDelete: Cascade)
  initiator         User        @relation("DealInitiator", fields: [initiatorId], references: [id])
  owner             User        @relation("DealOwner", fields: [ownerId], references: [id])
  renter            User        @relation("DealRenter", fields: [renterId], references: [id])
  reviews           Review[]

  @@index([listingId])
  @@index([ownerId])
  @@index([renterId])
  @@index([status])
}

model Review {
  id               String    @id @default(cuid())
  dealId           String
  reviewerId       String
  revieweeId       String
  rating           Int
  comment          String?
  trustImpact      Decimal   @db.Decimal(5, 2) @default(0)
  xpImpact         Int       @default(0)
  isHidden         Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  deal             Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  reviewer         User      @relation("ReviewAuthor", fields: [reviewerId], references: [id])
  reviewee         User      @relation("ReviewTarget", fields: [revieweeId], references: [id])

  @@unique([dealId, reviewerId])
  @@index([revieweeId])
}

model Account {
  id                 String   @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refreshToken       String?
  accessToken        String?
  expiresAt          Int?
  tokenType          String?
  scope              String?
  idToken            String?
  sessionState       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id            String   @id @default(cuid())
  sessionToken  String   @unique
  userId        String
  expires       DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
}

model VerificationToken {
  identifier  String
  token       String   @unique
  expires     DateTime

  @@unique([identifier, token])
  @@index([expires])
}
