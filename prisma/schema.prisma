generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  RESELLER
  MODERATOR
  ADMIN
}

enum VerificationLevel {
  UNVERIFIED
  PHONE_VERIFIED
  EMAIL_VERIFIED
  ID_VERIFIED
  BUSINESS_VERIFIED
  PROFESSIONAL_SELLER
}

enum ListingMode {
  RENT
  SWAP
  BOTH
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  RESERVED
  RENTED
  SWAPPED
  COMPLETED
  EXPIRED
  ARCHIVED
  REJECTED
}

enum ListingVisibility {
  PUBLIC
  PRIVATE
  HIDDEN
  FEATURED
  BOOSTED
}

enum DealStatus {
  PENDING
  CONFIRMED
  COMPLETED
  DISPUTED
  CANCELED
}

enum BookingStatus {
  REQUESTED
  APPROVED
  REJECTED
  CANCELED
  COMPLETED
  EXPIRED
}

enum AvailabilityDateStatus {
  AVAILABLE
  BLOCKED
  RESERVED
}

enum DefectSeverity {
  MINOR
  MEDIUM
  MAJOR
}

enum FraudReportStatus {
  OPEN
  UNDER_REVIEW
  CONFIRMED
  DISMISSED
}

model User {
  id                          String            @id @default(cuid())
  email                       String?           @unique
  phone                       String?           @unique
  passwordHash                String?
  resetToken                  String?           @unique
  resetTokenExpiry            DateTime?
  role                        UserRole          @default(USER)
  verificationLevel           VerificationLevel @default(UNVERIFIED)
  emailVerifiedAt             DateTime?
  phoneVerifiedAt             DateTime?
  idVerifiedAt                DateTime?
  businessVerifiedAt          DateTime?
  professionalSellerVerifiedAt DateTime?
  trustScore                  Decimal           @db.Decimal(5, 2) @default(50)
  trustTier                   Int               @default(0)
  xp                          Int               @default(0)
  level                       Int               @default(1)
  responseRate                Decimal           @db.Decimal(5, 2) @default(0)
  responseSpeedMinutes        Int               @default(0)
  cancellationRate            Decimal           @db.Decimal(5, 2) @default(0)
  accountAgeDays              Int               @default(0)
  fraudReportsCount           Int               @default(0)
  aiFraudScore                Decimal?          @db.Decimal(5, 2)
  isBanned                    Boolean           @default(false)
  createdAt                   DateTime          @default(now())
  updatedAt                   DateTime          @updatedAt

  profile                     Profile?
  ownedListings               Listing[]         @relation("ListingOwner")
  initiatedDeals              Deal[]            @relation("DealInitiator")
  dealsAsOwner                Deal[]            @relation("DealOwner")
  dealsAsRenter               Deal[]            @relation("DealRenter")
  writtenReviews              Review[]          @relation("ReviewAuthor")
  receivedReviews             Review[]          @relation("ReviewTarget")
  accounts                    Account[]
  sessions                    Session[]
  favorites                   Favorite[]
  savedListings               SavedListing[]
  savedSearches               SavedSearch[]
  recentlyViewed              RecentlyViewed[]
  bookingsAsRequester         Booking[]         @relation("BookingRequester")
  bookingsAsOwner             Booking[]         @relation("BookingOwner")
  fraudReportsCreated         FraudReport[]     @relation("FraudReporter")
  fraudReportsAgainst         FraudReport[]     @relation("FraudTarget")
  suspiciousSignals           SuspiciousUserSignal[] @relation("SuspiciousTarget")
  rateLimitEvents             RateLimitEvent[]

  @@index([role])
  @@index([trustScore])
  @@index([level])
}

model Profile {
  id               String   @id @default(cuid())
  userId           String   @unique
  handle           String   @unique
  displayName      String
  bio              String?
  avatarUrl        String?
  city             String?
  country          String?
  responseRate     Decimal  @db.Decimal(5, 2) @default(0)
  completionRate   Decimal  @db.Decimal(5, 2) @default(0)
  successfulDeals  Int      @default(0)
  failedDeals      Int      @default(0)
  reviewCount      Int      @default(0)
  averageRating    Decimal  @db.Decimal(3, 2) @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id               String     @id @default(cuid())
  slug             String     @unique
  name             String
  description      String?
  parentId         String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  parent           Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children         Category[] @relation("CategoryTree")
  listings         Listing[]

  @@index([parentId])
}

model Location {
  id                String    @id @default(cuid())
  country            String
  governorate        String
  city               String
  district           String?
  latitude           Decimal?  @db.Decimal(10, 7)
  longitude          Decimal?  @db.Decimal(10, 7)
  searchRadiusKm     Int?      @default(10)
  postalCode         String?
  formattedAddress   String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  listings           Listing[]

  @@index([country, governorate, city])
}

model Listing {
  id                  String             @id @default(cuid())
  ownerId             String
  categoryId          String
  locationId          String?
  title               String
  description         String
  mode                ListingMode
  status              ListingStatus      @default(DRAFT)
  visibility          ListingVisibility  @default(PUBLIC)
  quantity            Int                @default(1)
  priceAmount         Decimal?           @db.Decimal(12, 2)
  currencyCode        String?            @db.VarChar(3)
  minRentalDays       Int?               @default(1)
  maxRentalDays       Int?               @default(30)
  preparationDays     Int?               @default(0)
  cooldownDays        Int?               @default(0)
  trustScoreSnapshot  Decimal?           @db.Decimal(5, 2)
  ownerLevelSnapshot  Int?
  featuredUntil       DateTime?
  boostedUntil        DateTime?
  publishedAt         DateTime?
  expiresAt           DateTime?
  viewCount           Int                @default(0)
  imageUrl            String?
  swapPreferences     String?            @db.VarChar(200)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  owner               User               @relation("ListingOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  category            Category           @relation(fields: [categoryId], references: [id])
  location            Location?          @relation(fields: [locationId], references: [id])
  deals               Deal[]
  reviews             Review[]
  availabilityRules   AvailabilityRule[]
  availabilityDates   AvailabilityDate[]
  bookings            Booking[]
  favorites           Favorite[]
  savedListings       SavedListing[]
  recentlyViewed      RecentlyViewed[]
  duplicateSignalsAsPrimary DuplicateListingSignal[] @relation("PrimaryListing")
  duplicateSignalsAsSuspected DuplicateListingSignal[] @relation("SuspectedListing")
  fraudReports        FraudReport[]
  photos              ListingPhoto[]
  conditionMarks      ListingConditionMark[]
  offeredInBookings   BookingOfferedListing[]

  @@index([ownerId])
  @@index([categoryId])
  @@index([locationId])
  @@index([status, mode, visibility])
  @@index([viewCount])
}

model ListingPhoto {
  id         String   @id @default(cuid())
  listingId  String
  url        String
  sortOrder  Int      @default(0)
  isMain     Boolean  @default(false)
  createdAt  DateTime @default(now())

  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
}

model ListingConditionMark {
  id           String         @id @default(cuid())
  listingId    String
  description  String
  severity     DefectSeverity
  photoUrl     String?
  createdAt    DateTime       @default(now())

  listing      Listing        @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
}

model AvailabilityRule {
  id              String   @id @default(cuid())
  listingId       String
  dayOfWeek       Int
  startHour       Int
  endHour         Int
  isAvailable     Boolean  @default(true)
  isRecurring     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  listing         Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, dayOfWeek])
}

model AvailabilityDate {
  id              String                 @id @default(cuid())
  listingId       String
  date            DateTime
  status          AvailabilityDateStatus @default(AVAILABLE)
  notes           String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  listing         Listing                @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, date])
  @@index([listingId, status])
}

model Booking {
  id                 String        @id @default(cuid())
  listingId          String
  requesterId        String
  ownerId            String
  mode               ListingMode
  status             BookingStatus @default(REQUESTED)
  startDate          DateTime?
  endDate            DateTime?
  totalDays          Int?
  requestedAt        DateTime      @default(now())
  approvedAt         DateTime?
  rejectedAt         DateTime?
  canceledAt         DateTime?
  completedAt        DateTime?
  ownerMessage       String?
  requesterMessage   String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  listing            Listing                 @relation(fields: [listingId], references: [id], onDelete: Cascade)
  requester          User                    @relation("BookingRequester", fields: [requesterId], references: [id])
  owner              User                    @relation("BookingOwner", fields: [ownerId], references: [id])
  offeredListings    BookingOfferedListing[]
  deal               Deal?

  @@index([listingId, status])
  @@index([requesterId, startDate])
  @@index([ownerId, startDate])
}

model BookingOfferedListing {
  id         String  @id @default(cuid())
  bookingId  String
  listingId  String

  booking    Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  listing    Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([bookingId, listingId])
}

model Deal {
  id                String      @id @default(cuid())
  bookingId         String?     @unique
  listingId         String
  initiatorId       String
  ownerId           String
  renterId          String
  status            DealStatus  @default(PENDING)
  initiatedAt       DateTime    @default(now())
  ownerConfirmedAt  DateTime?
  renterConfirmedAt DateTime?
  completedAt       DateTime?
  disputedAt        DateTime?
  canceledAt        DateTime?
  xpReleased        Boolean     @default(false)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  booking           Booking?    @relation(fields: [bookingId], references: [id])
  listing           Listing     @relation(fields: [listingId], references: [id], onDelete: Cascade)
  initiator         User        @relation("DealInitiator", fields: [initiatorId], references: [id])
  owner             User        @relation("DealOwner", fields: [ownerId], references: [id])
  renter            User        @relation("DealRenter", fields: [renterId], references: [id])
  reviews           Review[]

  @@index([listingId])
  @@index([ownerId])
  @@index([renterId])
  @@index([status])
}

model Review {
  id               String    @id @default(cuid())
  dealId           String
  listingId        String
  reviewerId       String
  revieweeId       String
  rating           Int
  comment          String?
  trustImpact      Decimal   @db.Decimal(5, 2) @default(0)
  xpImpact         Int       @default(0)
  isHidden         Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  deal             Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  listing          Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reviewer         User      @relation("ReviewAuthor", fields: [reviewerId], references: [id])
  reviewee         User      @relation("ReviewTarget", fields: [revieweeId], references: [id])

  @@unique([dealId, reviewerId])
  @@index([revieweeId])
  @@index([listingId])
}

model Favorite {
  id          String   @id @default(cuid())
  userId      String
  listingId   String
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([listingId])
}

model SavedListing {
  id          String   @id @default(cuid())
  userId      String
  listingId   String
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([listingId])
}

model SavedSearch {
  id               String   @id @default(cuid())
  userId           String
  name             String
  keyword          String?
  categorySlug     String?
  governorate      String?
  city             String?
  district         String?
  radiusKm         Int?
  minPrice         Decimal? @db.Decimal(12, 2)
  maxPrice         Decimal? @db.Decimal(12, 2)
  mode             ListingMode?
  verifiedOnly     Boolean  @default(false)
  minTrustScore    Decimal? @db.Decimal(5, 2)
  minLevel         Int?
  sortBy           String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RecentlyViewed {
  id          String   @id @default(cuid())
  userId      String
  listingId   String
  viewedAt    DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([viewedAt])
}

model FraudReport {
  id              String            @id @default(cuid())
  reporterId      String
  targetUserId    String?
  listingId       String?
  reason          String
  details         String?
  status          FraudReportStatus @default(OPEN)
  aiScore         Decimal?          @db.Decimal(5, 2)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  reporter        User              @relation("FraudReporter", fields: [reporterId], references: [id])
  targetUser      User?             @relation("FraudTarget", fields: [targetUserId], references: [id])
  listing         Listing?          @relation(fields: [listingId], references: [id])

  @@index([status])
  @@index([targetUserId])
  @@index([listingId])
}

model DuplicateListingSignal {
  id                  String   @id @default(cuid())
  primaryListingId    String
  suspectedListingId  String
  similarityScore     Decimal  @db.Decimal(5, 2)
  createdAt           DateTime @default(now())

  primaryListing      Listing  @relation("PrimaryListing", fields: [primaryListingId], references: [id], onDelete: Cascade)
  suspectedListing    Listing  @relation("SuspectedListing", fields: [suspectedListingId], references: [id], onDelete: Cascade)

  @@unique([primaryListingId, suspectedListingId])
}

model SuspiciousUserSignal {
  id              String   @id @default(cuid())
  userId          String
  signalType      String
  severity        Int      @default(1)
  score           Decimal? @db.Decimal(5, 2)
  notes           String?
  createdAt       DateTime @default(now())

  user            User     @relation("SuspiciousTarget", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([signalType])
}

model RateLimitEvent {
  id              String   @id @default(cuid())
  userId          String?
  ipAddress       String
  route           String
  action          String
  createdAt       DateTime @default(now())

  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([ipAddress, route])
  @@index([createdAt])
}

model Account {
  id                 String   @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refreshToken       String?
  accessToken        String?
  expiresAt          Int?
  tokenType          String?
  scope              String?
  idToken            String?
  sessionState       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id            String   @id @default(cuid())
  sessionToken  String   @unique
  userId        String
  expires       DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
}

model VerificationToken {
  identifier  String
  token       String   @unique
  expires     DateTime

  @@unique([identifier, token])
  @@index([expires])
}
